# ─────────────────────────────────────────────────────────────
# Nexai Reactivation Engine — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon/publishable key (safe to expose; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key — SERVER ONLY. Full admin, bypasses RLS.
# Never prefix with NEXT_PUBLIC_ and never expose to the client.
# Used only for privileged server operations (e.g. seeding an admin).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
